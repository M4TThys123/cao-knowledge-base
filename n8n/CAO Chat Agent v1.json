    {
      "parameters": {
        "jsCode": "\nconst raw = $json.text || $json.output || '';\nconst cleaned = String(raw).replace(/^```(?:json)?\\s*\\n?/i, '').replace(/\\n?```\\s*$/i, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    lang: 'nl',\n    lang_name: 'Nederlands',\n    needs_translation: false,\n    translated_message: $('Merge Inputs').first().json.message\n  };\n}\nif (!parsed.translated_message) {\n  parsed.translated_message = $('Merge Inputs').first().json.message;\n}\nreturn [{ json: parsed }];\n"
      },
      "id": "059d9a5d-272a-402e-9337-add87d75ee58",
