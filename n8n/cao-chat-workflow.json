    {
      "parameters": {
        "jsCode": "\nconst output = $json.output || $json.text || '';\nconst fallbackTriggered = String(output).includes('Ik kan deze vraag niet met zekerheid beantwoorden');\nconst hasBron = /\\*\\*Bron:\\*\\*/i.test(output);\n\nconst langItem = $('Parse Lang JSON').first().json;\nconst originalLang = langItem.lang || 'nl';\nconst needsTranslationBack = originalLang !== 'nl' && !fallbackTriggered;\n\nreturn [{\n  json: {\n    output,\n    confidence_ok: !fallbackTriggered && hasBron,\n    needs_translation_back: needsTranslationBack,\n    original_lang: originalLang,\n    fallback_triggered: fallbackTriggered\n  }\n}];\n"
      },
      "id": "7155933c-4a44-472a-888a-b6c745769edc",
      "name": "Confidence Check",
